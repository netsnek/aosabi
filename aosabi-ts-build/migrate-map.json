    {"specifier": "@getcronit/pylon/queues", "until": "M9", "mark": true},
    {"specifier": "@getcronit/pylon/pages", "until": "M9", "mark": true},
    {"specifier": "@getcronit/pylon/pages/plugin", "until": "M9", "mark": true},
    {"specifier": "@getcronit/pylon/query", "until": "M9", "mark": true},
    {"specifier": "@getcronit/pylon/ir", "until": "M9", "mark": true},
